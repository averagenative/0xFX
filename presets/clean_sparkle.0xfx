{
  "format": "0xfx",
  "version": "1.0",
  "name": "Clean Sparkle",
  "author": "0xFX",
  "tags": ["clean", "sparkle", "ambient", "reverb"],
  "signal_chain": {
    "input": {
      "noise_gate": { "threshold_db": -55, "attack_ms": 1, "release_ms": 50, "hold_ms": 10 }
    },
    "pre_pedals": [],
    "chains": [
      {
        "amp": {
          "model": "fullerton_clean",
          "params": { "gain": 0.25, "volume": 0.65, "bass": 0.45, "mid": 0.5, "treble": 0.7, "presence": 0.6, "bright": 1.0 }
        },
        "cab": { "bypass": false },
        "mix": 1.0
      }
    ],
    "post_pedals": [
      {
        "type": "hall_verb",
        "bypass": false,
        "params": { "decay": 0.4, "damping": 0.3, "mix": 0.25 }
      }
    ]
  }
}
