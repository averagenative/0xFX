{
  "format": "0xfx",
  "version": "1.0",
  "name": "Modern High Gain",
  "author": "0xFX",
  "tags": ["high-gain", "metal", "modern", "tight"],
  "signal_chain": {
    "input": {
      "noise_gate": { "threshold_db": -40, "attack_ms": 0.5, "release_ms": 30, "hold_ms": 15 }
    },
    "pre_pedals": [
      {
        "type": "squeeze_box",
        "bypass": false,
        "params": { "output": 0.6, "sensitivity": 0.4 }
      }
    ],
    "chains": [
      {
        "amp": {
          "model": "southwest_lead",
          "params": { "gain": 0.8, "volume": 0.5, "bass": 0.45, "mid": 0.5, "treble": 0.6, "presence": 0.65, "sag": 0.15, "master": 0.5 }
        },
        "cab": { "bypass": false },
        "mix": 1.0
      }
    ],
    "post_pedals": [
      {
        "type": "echo_delay",
        "bypass": false,
        "params": { "time": 0.3, "feedback": 0.2, "mix": 0.1 }
      }
    ]
  }
}
