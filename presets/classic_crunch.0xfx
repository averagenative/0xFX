{
  "format": "0xfx",
  "version": "1.0",
  "name": "Classic Crunch",
  "author": "0xFX",
  "tags": ["crunch", "rock", "british", "overdrive"],
  "signal_chain": {
    "input": {
      "noise_gate": { "threshold_db": -48, "attack_ms": 1, "release_ms": 40, "hold_ms": 10 }
    },
    "pre_pedals": [
      {
        "type": "jade_drive",
        "bypass": false,
        "params": { "drive": 0.45, "tone": 0.55, "level": 0.7 }
      }
    ],
    "chains": [
      {
        "amp": {
          "model": "brit_crunch",
          "params": { "gain": 0.6, "volume": 0.5, "bass": 0.5, "mid": 0.65, "treble": 0.55, "presence": 0.5, "sag": 0.3, "master": 0.55 }
        },
        "cab": { "bypass": false },
        "mix": 1.0
      }
    ],
    "post_pedals": [
      {
        "type": "echo_delay",
        "bypass": false,
        "params": { "time": 0.35, "feedback": 0.25, "mix": 0.15 }
      }
    ]
  }
}
