{
  "format": "0xfx",
  "version": "1.0",
  "name": "Chimey British",
  "author": "0xFX",
  "tags": ["chime", "jangle", "british", "clean"],
  "signal_chain": {
    "input": {
      "noise_gate": { "threshold_db": -55, "attack_ms": 1, "release_ms": 50, "hold_ms": 10 }
    },
    "pre_pedals": [],
    "chains": [
      {
        "amp": {
          "model": "essex_chime",
          "params": { "gain": 0.45, "volume": 0.6, "bass": 0.35, "mid": 0.5, "treble": 0.7, "presence": 0.55, "cut": 0.4 }
        },
        "cab": { "bypass": false },
        "mix": 1.0
      }
    ],
    "post_pedals": [
      {
        "type": "hall_verb",
        "bypass": false,
        "params": { "decay": 0.35, "damping": 0.4, "mix": 0.2 }
      }
    ]
  }
}
