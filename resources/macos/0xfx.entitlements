<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Live guitar input through the standalone app -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Required for notarization of apps linking SDL2 / OpenGL via dynamic libs -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow JIT / writable-executable memory (safe default for audio plugins
         and ImGui backends; tighten later if profiling shows it's unused) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
